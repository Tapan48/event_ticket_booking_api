SECRET_KEY=dev-insecure-change-me-this-key-signs-jwts-so-keep-it-50-plus-chars
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Postgres (used by the db service and DATABASE_URL)
POSTGRES_DB=ticketing
POSTGRES_USER=ticketing
POSTGRES_PASSWORD=ticketing
POSTGRES_HOST_PORT=5434
DATABASE_URL=postgres://ticketing:ticketing@db:5432/ticketing

REDIS_URL=redis://redis:6379/0

# Dev email goes to Mailpit (inbox: http://localhost:8025)
EMAIL_URL=smtp://mailpit:1025
DEFAULT_FROM_EMAIL=Ticketing <tickets@ticketing.local>
